{% extends "base.html" %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary"><i class="bi bi-calendar-check"></i> Auditoría de Mantenimiento</h2>
    
    <div class="d-flex gap-2">
        <div class="nfc-waiting py-2 px-4" style="border-color: var(--primary);" onclick="document.getElementById('nfc_auditor').focus()">
            <i class="bi bi-qr-code-scan"></i> <strong>ESCANEAR UNIDAD PARA SERVICE</strong>
            <form method="POST" action="{{ url_for('auditor_validar_nfc') }}">
                <input type="text" name="nfc_code" id="nfc_auditor" class="nfc-input" autocomplete="off">
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card card-custom p-3">
            <div id="calendar"></div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },
            events: '/api/eventos_calendario', // Endpoint JSON que crearemos en Python
            eventClick: function(info) {
                alert('Unidad: ' + info.event.title + '\nEstado: ' + info.event.extendedProps.status);
            }
        });
        calendar.render();
        
        // Foco NFC
        document.getElementById('nfc_auditor').focus();
        document.addEventListener('click', function() { document.getElementById('nfc_auditor').focus(); });
    });
</script>
{% endblock %}